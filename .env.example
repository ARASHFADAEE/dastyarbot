# IMPORTANT: Nest API reads apps/api/.env (copy this file there too).
# For freelancers: catalog items are SERVICES (WordPress / Laravel / Automation).

# Database — production: Prisma Postgres / any Postgres
# Local fallback was SQLite; production must use Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Optional aliases (some hosts export these names — map them to DATABASE_URL):
# POSTGRES_URL="postgresql://..."
# PRISMA_DATABASE_URL="postgresql://..."

# Redis (optional / future workers)
REDIS_URL="redis://localhost:6379"

# AvalAI (never commit real keys)
AVALAI_API_KEY="aa-YOUR_API_KEY"
AVALAI_BASE_URL="https://api.avalai.ir/v1"
AVALAI_CHAT_MODEL="gpt-5.4-mini"
AVALAI_EMBEDDING_MODEL="text-embedding-3-small"
AVALAI_STT_MODEL="whisper-1"
AVALAI_TTS_MODEL="tts-1"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""  # only for webhook mode; leave empty when using polling
TELEGRAM_ADMIN_CHAT_ID=""  # your numeric Telegram user id — receives handoff/call alerts
# Shortcodes (send inside customer chat as admin): #من = take over, #ربات = resume AI

# App
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500"
ADMIN_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001"
NODE_ENV="development"

# Next.js admin
NEXT_PUBLIC_API_URL="http://localhost:3001"
